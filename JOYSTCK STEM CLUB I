int eixoX = A0;
int eixoY = A1;
int botao = 2;

void setup() {
  Serial.begin(9600);
  pinMode(botao, INPUT_PULLUP);
  pinMode(2, OUTPUT); // CIMA
  pinMode(3, OUTPUT); // BAIXO
  pinMode(4, OUTPUT); // DIREITA
  pinMode(5, OUTPUT); // ESQUERDA
}

void loop() {
  int x = analogRead(eixoX);
  int y = analogRead(eixoY);
  int b = digitalRead(botao);
  
  delay(200);
}
